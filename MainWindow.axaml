<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:GraphicsEditor"
        x:Class="GraphicsEditor.MainWindow"
        Title="Графический редактор"
        Width="1000" Height="760" MinWidth="900">
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="8" BorderThickness="0,0,0,1" BorderBrush="#DDDDDD">
      <WrapPanel Orientation="Horizontal">
        <StackPanel x:Name="ToolsPanel" Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center" />
        <ColorPicker x:Name="ColorSelector" Margin="0,0,16,0" VerticalAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center">
          <TextBlock Text="Толщина:" VerticalAlignment="Center" />
          <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="30" Width="160" VerticalAlignment="Center" />
          <TextBlock x:Name="ThicknessText" Width="30" VerticalAlignment="Center" />
        </StackPanel>
        <Button x:Name="UndoButton" Content="← Назад" Margin="0,0,8,0" />
        <Button x:Name="RedoButton" Content="Вперёд →" Margin="0,0,16,0" />
        <Button x:Name="ClearButton" Content="Очистить холст" Margin="0,0,8,0" />
        <Button x:Name="SaveButton" Content="Сохранить изображение" />
      </WrapPanel>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#E8E8E8">
      <Border Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center"
              BorderBrush="#999999" BorderThickness="1">
        <local:CanvasView x:Name="DrawingCanvas" Width="800" Height="560" />
      </Border>
    </ScrollViewer>
  </DockPanel>
</Window>
